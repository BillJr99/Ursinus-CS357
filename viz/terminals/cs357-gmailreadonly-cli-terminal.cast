{"version": 2, "width": 100, "height": 30, "title": "Gmail read-only: CLI path", "code_viz_provenance": "scripted", "duration": 0.006}
[0.0, "m", "Set up Google OAuth and install the CLI"]
[0.0, "o", "$ npm install -g @googleworkspace/cli@0.22.5\r\n"]
[0.0, "o", ""]
[0.001, "m", "Check the installation"]
[0.001, "o", "$ gws --version\r\n"]
[0.001, "o", "gws 0.22.5\nThis is not an officially supported Google product.\n"]
[0.002, "m", "Store the client file"]
[0.002, "o", "$ export GOOGLE_WORKSPACE_CLI_CONFIG_DIR=\"$HOME/.config/cs357-gmail-readonly\"\r\n"]
[0.002, "o", ""]
[0.003, "m", "Authorize the CLI"]
[0.003, "o", "$ gws auth login --scopes https://www.googleapis.com/auth/gmail.readonly\r\n"]
[0.003, "o", ""]
[0.004, "m", "Inspect the request without calling Gmail"]
[0.004, "o", "$ gws gmail users messages list --dry-run --params '{\"userId\":\"me\",\"q\":\"subject:\\\"CS357 MCP DEMO\\\"\",\"maxResults\":3}'\r\n"]
[0.004, "o", "{\n  \"body\": null,\n  \"dry_run\": true,\n  \"is_multipart_upload\": false,\n  \"method\": \"GET\",\n  \"query_params\": [\n    [\n      \"maxResults\",\n      \"3\"\n    ],\n    [\n      \"q\",\n      \"subject:\\\"CS357 MCP DEMO\\\"\"\n    ]\n  ],\n  \"url\": \"https://gmail.googleapis.com/gmail/v1/users/me/messages\"\n}\n"]
[0.005, "m", "Test with a Read-Only Request"]
[0.005, "o", "$ opencode\r\n"]
[0.005, "o", ""]
