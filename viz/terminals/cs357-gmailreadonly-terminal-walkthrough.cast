{"version": 2, "width": 100, "height": 30, "title": "Check the Gmail adapter with its fixture", "code_viz_provenance": "scripted", "duration": 0.003}
[0.0, "m", "Create an isolated Python environment"]
[0.0, "o", "$ python3 -m venv .venv\r\n"]
[0.0, "o", ""]
[0.001, "m", "Install the adapter dependencies"]
[0.001, "o", "$ .venv/bin/python -m pip install -r requirements.txt\r\n"]
[0.001, "o", "Successfully installed requirements\n"]
[0.002, "m", "Run the check without signing in"]
[0.002, "o", "$ .venv/bin/python gmail_readonly.py check --fixture\r\n"]
[0.002, "o", "Fixture check completed.\n"]
