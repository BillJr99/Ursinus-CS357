{"version": 2, "width": 100, "height": 30, "title": "Gmail read-only: MCP path", "code_viz_provenance": "scripted", "duration": 0.007}
[0.0, "m", "Set up Google OAuth and get the adapter"]
[0.0, "o", "$ python3 -m venv .venv\r\n"]
[0.0, "o", ""]
[0.001, "m", "Install the adapter dependencies"]
[0.001, "o", "$ .venv/bin/python -m pip install -r requirements.txt\r\n"]
[0.001, "o", ""]
[0.002, "m", "Check the fixture"]
[0.002, "o", "$ .venv/bin/python gmail_readonly.py check --fixture\r\n"]
[0.002, "o", "Fixture mode; no Google access.\n"]
[0.003, "m", "Authorize the adapter"]
[0.003, "o", "$ .venv/bin/python gmail_readonly.py authorize\r\n"]
[0.003, "o", ""]
[0.004, "m", "Check the saved grant"]
[0.004, "o", "$ .venv/bin/python gmail_readonly.py check\r\n"]
[0.004, "o", ""]
[0.005, "m", "Connect the agent"]
[0.005, "o", "$ opencode mcp list\r\n"]
[0.005, "o", ""]
[0.006, "m", "Test with a Read-Only Request"]
[0.006, "o", "$ opencode\r\n"]
[0.006, "o", ""]
