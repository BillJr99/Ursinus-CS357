x = [1.0, 2.0]
  h1: pre = 0.5*1.0 + 1.0*2.0 + -0.5 = +2.00  -> ReLU -> 2.00
  h2: pre = 1.0*1.0 + -1.0*2.0 + 0.5 = -0.50  -> ReLU -> 0.00
  y  = 1.5*2.00 + 2.0*0.00 + 0.25 = 3.25

x = [2.0, 1.0]
  h1: pre = 0.5*2.0 + 1.0*1.0 + -0.5 = +1.50  -> ReLU -> 1.50
  h2: pre = 1.0*2.0 + -1.0*1.0 + 0.5 = +1.50  -> ReLU -> 1.50
  y  = 1.5*1.50 + 2.0*1.50 + 0.25 = 5.50

x = [0.0, 0.0]
  h1: pre = 0.5*0.0 + 1.0*0.0 + -0.5 = -0.50  -> ReLU -> 0.00
  h2: pre = 1.0*0.0 + -1.0*0.0 + 0.5 = +0.50  -> ReLU -> 0.50
  y  = 1.5*0.00 + 2.0*0.50 + 0.25 = 1.25

