{
  "$schema": "https://opencode.ai/config.json",
  "update": "disable",
  "permissions": [
    {
      "action": "shell",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "rm *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "/bin/rm *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "/usr/bin/rm *",
      "effect": "deny"
    }
  ],
  "policies": [
    {
      "action": "tool.use",
      "resource": "shell:rm *",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "shell:/bin/rm *",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "shell:/usr/bin/rm *",
      "effect": "deny"
    }
  ]
}
